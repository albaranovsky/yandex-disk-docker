#!/usr/bin/env bash
set -e

CONFIG_DIR="/data/config"
DATA_DIR="/data/disk"

if [ $# -eq 0 ] || [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    cat << 'EOF'
Usage: yadisk <command> [options]

Commands:
  start [options]        Run synchronization in foreground (--no-daemon)
  setup                  Run the interactive setup wizard explicitly
  token [file]           Obtain OAuth token (default: /data/config/passwd)
  status                 Show synchronization status (supports --last)
  sync                   Trigger synchronization
  stop                   Stop synchronization
  publish <file/dir>     Make file or folder public
  unpublish <file/dir>   Revoke public link

Options are passed to yandex-disk. For start, use CLI flags or EXCLUDE/PROXY;
--no-daemon ignores config.cfg. Prepare host storage permissions before use.
EOF
    exit 0
fi

CMD="$1"
shift
ARGS=()
[ -z "${PROXY:-}" ] || ARGS+=(--proxy="$PROXY")

if [ "$CMD" = "start" ]; then
    if [ ! -s "$CONFIG_DIR/passwd" ]; then
        echo "[!] Authentication token is missing or empty: $CONFIG_DIR/passwd. Run make setup or yadisk token first." >&2
        exit 1
    fi
    if [ ! -r "$CONFIG_DIR/passwd" ] || [ ! -d "$CONFIG_DIR" ] || [ ! -w "$CONFIG_DIR" ] || \
       [ ! -d "$DATA_DIR" ] || [ ! -w "$DATA_DIR" ]; then
        echo "[!] Storage is not accessible. Check token read access and write permissions for $CONFIG_DIR and $DATA_DIR on the host." >&2
        exit 1
    fi
    ARGS+=(--dir="$DATA_DIR" --auth="$CONFIG_DIR/passwd" --no-daemon)
    [ -z "${EXCLUDE:-}" ] || ARGS+=(--exclude-dirs="$EXCLUDE")
else
    [ ! -f "$CONFIG_DIR/config.cfg" ] || ARGS+=(--config="$CONFIG_DIR/config.cfg")
    case "$CMD" in
        status|sync|stop|setup|publish|unpublish)
            ARGS+=(--dir="$DATA_DIR")
            [ ! -f "$CONFIG_DIR/passwd" ] || ARGS+=(--auth="$CONFIG_DIR/passwd")
            ;;
        token)
            [ $# -ne 0 ] || set -- "$CONFIG_DIR/passwd"
            ;;
    esac
    ARGS+=("$CMD")
fi

exec yandex-disk "${ARGS[@]}" "$@"
